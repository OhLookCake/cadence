{
  "version": 1,
  "name": "Daily report",
  "description": "A starting point for a handwritten task.",
  "enabled": false,
  "workingDirectory": "~",
  "schedule": {
    "kind": "daily",
    "hour": 9,
    "minute": 0
  },
  "missedPolicy": "latest",
  "steps": [
    {
      "name": "Generate report",
      "kind": "shell",
      "body": "printf 'Scheduled date: %s\\n' \"$TASK_SCHEDULED_DATE\"",
      "timeoutSeconds": 60
    },
    {
      "name": "Display report",
      "kind": "alert",
      "body": "{{previous_output}}",
      "timeoutSeconds": 120
    }
  ]
}
