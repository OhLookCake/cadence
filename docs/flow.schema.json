{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cadence flow",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "schedule", "steps"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1, "default": 1},
    "id": {"type": "string", "format": "uuid"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "enabled": {"type": "boolean", "default": false},
    "workingDirectory": {"type": "string", "default": "~"},
    "environment": {"type": "string"},
    "missedPolicy": {"enum": ["skip", "latest", "all"], "default": "latest"},
    "catchUpLimit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 5},
    "graceSeconds": {"type": "integer", "minimum": 0, "maximum": 3600, "default": 90},
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["daily", "weekly", "everyDays", "interval", "once"]},
        "timeZone": {"type": "string", "examples": ["Europe/London", "America/New_York", "UTC"]},
        "hour": {"type": "integer", "minimum": 0, "maximum": 23, "default": 9},
        "minute": {"type": "integer", "minimum": 0, "maximum": 59, "default": 0},
        "every": {"type": "integer", "minimum": 1, "maximum": 10000},
        "weekdays": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 7}},
        "anchor": {"type": "string", "format": "date-time"}
      },
      "allOf": [{"if": {"properties": {"kind": {"enum": ["everyDays", "interval", "once"]}}}, "then": {"required": ["anchor"]}}]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "name": {"type": "string"},
          "key": {"type": "string", "maxLength": 40, "pattern": "^([a-z][a-z0-9_]{0,39})?$"},
          "runIf": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step", "operator"],
            "properties": {
              "step": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
              "field": {"enum": ["output", "status"], "default": "output"},
              "operator": {"enum": ["isEmpty", "isNotEmpty", "equals", "notEquals", "contains", "notContains"]},
              "value": {"type": "string", "default": ""}
            },
            "allOf": [{
              "if": {"required": ["field"], "properties": {"field": {"const": "status"}}},
              "then": {
                "required": ["value"],
                "properties": {
                  "operator": {"enum": ["equals", "notEquals"]},
                  "value": {"enum": ["succeeded", "failed", "skipped", "cancelled"]}
                }
              }
            }]
          },
          "kind": {"enum": ["shell", "script", "codex", "localLLM", "userInput", "alert", "question", "response", "saveFile"]},
          "body": {"type": "string", "minLength": 1},
          "scriptPath": {"type": "string", "minLength": 1},
          "executable": {"type": "string"},
          "arguments": {"oneOf": [{"type": "array", "items": {"type": "string", "pattern": "^[^\\n]*$"}}, {"type": "string"}]},
          "model": {"type": "string"},
          "endpoint": {"type": "string", "format": "uri"},
          "sandbox": {"enum": ["read-only", "workspace-write"]},
          "outputPath": {"type": "string"},
          "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
          "continueOnFailure": {"type": "boolean", "default": false}
        },
        "allOf": [
          {"if": {"properties": {"kind": {"const": "script"}}}, "then": {"required": ["scriptPath"]}, "else": {"required": ["body"]}},
          {"if": {"properties": {"kind": {"const": "localLLM"}}}, "then": {"required": ["model"]}},
          {"if": {"properties": {"kind": {"const": "saveFile"}}}, "then": {"required": ["outputPath"], "properties": {"outputPath": {"minLength": 1}}}}
        ]
      }
    }
  }
}
